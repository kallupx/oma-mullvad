{
  "schemaVersion": 1,
  "id": "io.github.kallupx.oma-mullvad",
  "name": "OmaMullvad",
  "version": "0.1.0",
  "author": "kallupx",
  "license": "MIT",
  "description": "A theme-aware Mullvad VPN control and status widget for the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaMullvad",
    "description": "Monitor and control Mullvad from a native Omarchy panel.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "favoriteLocations": [],
      "recentLocations": [],
      "refreshIntervalSec": 30
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Fallback refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      }
    ]
  }
}

    Repeater {
      model: root.locations || []

      Rectangle {
        required property var modelData
        visible: modelData && isFinite(Number(modelData.latitude)) && isFinite(Number(modelData.longitude))
        x: root.pointX(modelData) - width / 2
        y: root.pointY(modelData) - height / 2
        width: 5
        height: width
        radius: width / 2
        color: Util.alpha(root.foreground, 0.52)
      }
    }

    Rectangle {
      visible: root.selectedPoint && isFinite(Number(root.selectedPoint.latitude))
        && isFinite(Number(root.selectedPoint.longitude))
      x: root.pointX(root.selectedPoint) - width / 2
      y: root.pointY(root.selectedPoint) - height / 2
      width: 15
      height: width
      radius: width / 2
      color: "transparent"
      border.width: 2.5
      border.color: root.foreground
    }

    Rectangle {
      visible: root.connectedPoint && isFinite(Number(root.connectedPoint.latitude))
        && isFinite(Number(root.connectedPoint.longitude))
      x: root.pointX(root.connectedPoint) - width / 2
      y: root.pointY(root.connectedPoint) - height / 2
      width: 11
      height: width
      radius: width / 2
      color: root.accent
      border.width: 1.5
      border.color: root.foreground
    }
